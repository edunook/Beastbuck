# Copy to .env and fill secrets locally (never commit .env)

# Client Firebase (Firebase Console → Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.region.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Admin SDK — download JSON from Firebase Console → Project settings → Service accounts
# Save as service-account.json (gitignored). Do NOT use in React/Vite client code.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
FIREBASE_PROJECT_ID=beastbuck-5c42b

# Backblaze B2 Storage (Server-only credentials — NEVER expose to browser builds)
# S3-Compatible API endpoint from Backblaze B2 Console
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_BUCKET=beastbuck-media
B2_KEY_ID=your_b2_application_key_id
B2_APPLICATION_KEY=your_b2_application_key

# Cloudflare CDN Delivery & Range Streaming
CDN_MEDIA_BASE_URL=https://media.beastbuck.com
VITE_CDN_MEDIA_BASE_URL=https://media.beastbuck.com

# Upload Configuration (Configurable thresholds and scaling limits)
MULTIPART_THRESHOLD_MB=50
MAX_UPLOAD_SIZE_GB=50
MAX_VIDEO_SIZE_GB=50

# Legacy Pinata / IPFS (Deprecated — Migrated to Backblaze B2)
# VITE_PINATA_API_KEY=your_pinata_api_key
# VITE_PINATA_SECRET_KEY=your_pinata_secret_key

VITE_AI_PROVIDER=auto
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL=gemini-1.5-flash
VITE_GEMINI_API_VERSION=v1
VITE_GEMINI_MODEL_FALLBACKS=gemini-1.5-flash-8b,gemini-2.0-flash,gemini-1.5-flash,gemini-1.0-pro
VITE_GROQ_API_KEY=your_groq_api_key_here
VITE_GROQ_MODEL=llama-3.1-8b-instant
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here
VITE_OPENROUTER_MODEL=google/gemma-3-27b-it
