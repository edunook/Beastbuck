{
  "rules": {
    ".read": false,
    ".write": false,
    "status": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "documentPresence": {
      "$docId": {
        ".read": "auth != null",
        ".write": "auth != null && (newData.child('users').child(auth.uid).exists() || auth.uid == $docId)",
        "users": {
          "$uid": {
            ".read": "auth != null",
            ".write": "auth != null && auth.uid == $uid"
          }
        }
      }
    },
    "chatPresence": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && newData.child('users').child(auth.uid).exists() || auth.uid == $roomId",
        "users": {
          "$uid": {
            ".read": "auth != null",
            ".write": "auth != null && auth.uid == $uid"
          }
        }
      }
    },
    "battleRuntime": {
      "$matchId": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('meta').child('hostId').val() == auth.uid",
        "meta": {
          "hostId": {
            ".write": "auth != null && ((!data.exists() && newData.val() == auth.uid) || data.val() == auth.uid || (data.val() == null && newData.val() == auth.uid && root.child('battleRuntime').child($matchId).child('presence').child(auth.uid).exists()))"
          },
          "$field": {
            ".write": "auth != null && data.parent().child('hostId').val() == auth.uid"
          }
        },
        "state": {
          ".write": "auth != null && data.parent().child('meta').child('hostId').val() == auth.uid"
        },
        "inputs": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid"
          }
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid"
          }
        }
      }
    }
  }
}
