{
  "rules": {
    ".read": false,
    ".write": false,
    "status": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "documentPresence": {
      "$docId": {
        ".read": "auth != null",
        ".write": "auth != null && (newData.child('users').child(auth.uid).exists() || auth.uid == $docId)",
        "users": {
          "$uid": {
            ".read": "auth != null",
            ".write": "auth != null && auth.uid == $uid"
          }
        }
      }
    },
    "chatPresence": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && newData.child('users').child(auth.uid).exists() || auth.uid == $roomId",
        "users": {
          "$uid": {
            ".read": "auth != null",
            ".write": "auth != null && auth.uid == $uid"
          }
        }
      }
    }
  }
}
